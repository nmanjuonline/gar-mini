{
  "name": "Garmini",
  "short_name": "Garmini",
  "description": "Garmin Personal API Training Dashboard & Marathon Prep",
  "start_url": "/?mode=pwa",
  "scope": "/",
  "display": "standalone",
  "background_color": "#080b11",
  "theme_color": "#16a34a",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://garmini.nmanjuonline.workers.dev/manifest.json"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}